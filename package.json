{
  "name": "valis",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "rebuild": "electron-rebuild",
    "postinstall": "electron-rebuild",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "proxy": "node electron/services/ProxyServer.js",
    "desktop": "concurrently \"vite\" \"wait-on tcp:3000 && electron .\"",
    "build:win": "tsc && vite build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@supabase/supabase-js": "^2.39.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-router": "^5.1.20",
    "axios": "^1.7.9",
    "better-sqlite3": "^12.5.0",
    "cheerio": "^1.0.0",
    "chokidar": "^5.0.0",
    "clsx": "^2.1.1",
    "colorthief": "^2.6.0",
    "date-fns": "^2.30.0",
    "electron-updater": "^6.3.9",
    "framer-motion": "^12.4.2",
    "html2canvas": "^1.4.1",
    "kysely": "^0.27.6",
    "lodash": "^4.17.21",
    "lucide-react": "^0.468.0",
    "ps-list": "^9.0.0",
    "psn-api": "^2.9.0",
    "react": "^19.2.1",
    "react-calendar-heatmap": "^1.10.0",
    "react-dom": "^19.2.1",
    "react-grid-layout": "^2.1.1",
    "react-router-dom": "^6.28.0",
    "recharts": "^3.6.0",
    "systeminformation": "^5.27.14",
    "tailwind-merge": "^3.4.0",
    "wa-sqlite": "^1.0.0",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.2",
    "@types/lodash": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react-grid-layout": "^1.3.6",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.22",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "electron": "^39.2.6",
    "electron-builder": "^25.1.8",
    "express": "^4.21.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.valis.app",
    "productName": "Valis",
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Valis"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Saga-Src",
        "repo": "Valis",
        "releaseType": "release"
      }
    ]
  }
}